+const source=ts.transpileModule(await fs.readFile(new URL('../lib/tracking.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS}}).outputText;
+function browser(choice){const stored=new Map(),listeners=new Map(),scripts=[];if(choice)stored.set('taksh-analytics-consent',choice);const exports={},location={hostname:'taksh.store',pathname:'/',href:'https://taksh.store/'};const window={addEventListener:(n,fn)=>listeners.set(n,fn)};const context={exports,require:n=>n==='./shop'?{brand:{ga:'G-TEST'},catalogueProducts:[{slug:'set',setNumber:'01',name:'Set',price:100}]}:n==='./tracking-domain.mjs'?domain:consent,window,location,navigator:{userAgent:'Mozilla/5.0',webdriver:false},localStorage:{getItem:k=>stored.get(k)||null,setItem:(k,v)=>stored.set(k,v)},URL,Event,document:{referrer:'',head:{appendChild:s=>scripts.push(s)},createElement:()=>({})}};vm.runInNewContext(source,context);return {api:exports,stored,listeners,scripts,location,window,events:()=>window.dataLayer?.filter(args=>args[0]==='event')||[]}}
