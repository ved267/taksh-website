+export function requestTraffic(details={},userAgent='',internal=false){if(internal||/@(?:example\.test|example\.invalid)$/i.test(details.email||''))return 'test';return /bot\b|crawler|spider|headless|preview|facebookexternalhit/i.test(userAgent)?'automated':'external'}
+export function preserveTraffic(previous,current){return previous==='test'||previous==='automated'?previous:current}
