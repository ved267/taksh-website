# App secrets: enter values privately in Cloudflare Worker Settings -> Variables and Secrets.
ADMIN_PASSWORD_HASH=
CUSTOMER_SHEET_SYNC_KEY=
# Existing Sites setting; exact v60 does not read this. No contacts in Git.
INTERNAL_CONTACTS=
# Optional: only configure when customer email delivery is intentionally enabled.
RESEND_API_KEY=
FROM_EMAIL=
# APP_ENV is a non-secret Wrangler variable; DB and BUCKET are native D1/R2 bindings.
# Preview secrets are independent; previews cannot send customer email.

# Backup Worker secret only (not the storefront Worker): scoped D1 export credential.
D1_BACKUP_TOKEN=
# Backup non-secret variables/binding are in wrangler.backup.json:
# CLOUDFLARE_ACCOUNT_ID, D1_DATABASE_ID, BACKUPS.

# Deployment credential only in this repository's GitHub Actions secrets.
# Normal Claude/Codex contributions need GitHub alone; app secrets stay in Cloudflare.
CLOUDFLARE_API_TOKEN=

# Optional non-secret build/test controls; never credentials.
# TAKSH_PERFORMANCE_BUILD_ID: CI-only fixed metadata for fair byte comparisons.
# TAKSH_WRANGLER_CONFIG: wrangler.staging.json for a dedicated staging build.
# TAKSH_PREVIEW_BRANCH: GitHub Actions branch (claude/* or codex/*).
# TAKSH_PREVIEW_BUNDLE_ROOT: verified compiled artifact directory, set only by trusted Actions tooling.
