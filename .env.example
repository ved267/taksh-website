ADMIN_PASSWORD_HASH=
RESEND_API_KEY=
FROM_EMAIL=

# Private read-only export credential for the owner Google Sheet sync.
CUSTOMER_SHEET_SYNC_KEY=

# Optional hosted libSQL connection. Local development uses the ignored .local folder.
# Hosted Vercel execution requires both values and refuses local database files.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Private upload storage; no storage account is created by installing the SDK.
BLOB_READ_WRITE_TOKEN=
